+            let text = "A中文👩🏽‍💻\r\n".repeat(9000);
+            let encode = |text: &str| -> Vec<u8> {
+                match encoding {
+                    crate::piece_tree::BaseEncoding::Utf8 => text.as_bytes().to_vec(),
+                    _ => {
+                        let le = encoding == crate::piece_tree::BaseEncoding::Utf16Le;
+                        let mut out = if le { vec![0xff,0xfe] } else { vec![0xfe,0xff] };
+                        for unit in text.encode_utf16() { out.extend(if le { unit.to_le_bytes() } else { unit.to_be_bytes() }); }
+                        out
+                    }
+                }
