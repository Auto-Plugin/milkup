+
+// Temporary phase20 diagnostic build only; removed before product changes.
+pub(crate) struct Phase20Span { id: u64, name: String, start: std::time::Instant }
+impl Phase20Span {
+    pub(crate) fn new(name: impl Into<String>) -> Self {
+        static NEXT: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(1);
+        let span = Self { id: NEXT.fetch_add(1, std::sync::atomic::Ordering::Relaxed), name: name.into(), start: std::time::Instant::now() };
+        span.mark("begin"); span
+    }
+    pub(crate) fn mark(&self, stage: &str) {
+        let wall = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_micros();
+        eprintln!("PHASE20 {} {} {:?} {} {} {:.3}", wall, self.id, std::thread::current().id(), self.name, stage, self.start.elapsed().as_secs_f64()*1000.0);
+    }
+}
+impl Drop for Phase20Span { fn drop(&mut self) { self.mark("end"); } }
