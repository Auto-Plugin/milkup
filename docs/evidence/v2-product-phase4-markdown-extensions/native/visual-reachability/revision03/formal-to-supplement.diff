+// Supplemental public-input checks prompted by actual partial-view screenshots.
+// These do not replace the unchanged formal matrix or count as its acceptance.
+// Geometry is in WebView CSS pixels; native coordinates are derived only at input.
+const reachabilityClientGeometry = `
+const clientRect = element => {
+  const r = element.getBoundingClientRect();
+  const left = r.left + element.clientLeft, top = r.top + element.clientTop;
+  return {left: Math.max(0, left), top: Math.max(0, top),
+    right: Math.min(innerWidth, left + element.clientWidth),
+    bottom: Math.min(innerHeight, top + element.clientHeight)};
+};
+`
+function assertPositiveRect(rect, message) {
+  assert(rect && ['left','right','top','bottom'].every(k => Number.isFinite(rect[k])) &&
+    rect.right > rect.left && rect.bottom > rect.top, message)
+}
+function assertCaretVisible(geometry, position, label) {
+  assertPositiveRect(geometry.editor, label + ' editor client viewport has positive area')
+  assertPositiveRect(geometry.caret, label + ' caret has positive area')
+  assert.equal(geometry.position, position, label + ' rendered caret matches source offset')
+  assert(geometry.caret.left >= geometry.editor.left-1 && geometry.caret.right <= geometry.editor.right+1, label + ' caret horizontally visible')
+  assert(geometry.caret.top >= geometry.editor.top-1 && geometry.caret.bottom <= geometry.editor.bottom+1, label + ' caret vertically visible')
+}
+async function caretGeometry() {
+  return app.execute(reachabilityClientGeometry + `
+const e=document.querySelector('.milkup-editor'), c=document.querySelector('.milkup-cursor');
+return {editor:clientRect(e),editorBorder:e.getBoundingClientRect().toJSON(),
+  caret:c?.getBoundingClientRect().toJSON(),position:Number(c?.dataset.position),
+  scrollLeft:e.scrollLeft,scrollTop:e.scrollTop};`)
+}
+async function vectorGeometry(sample, text, hitTest = false) {
+  const from = text.indexOf(sample.needle)
+  assert(from >= 0, 'Vector needle exists in the unchanged fixture')
+  return app.execute(reachabilityClientGeometry + `
+const e=document.querySelector('.milkup-editor');
+const p=[...document.querySelectorAll('[data-document-presentation]')].find(p=>
+  Number(p.dataset.presentationFrom)<=arguments[0]&&Number(p.dataset.presentationTo)>arguments[0]);
+const s=p?.querySelector('svg');
+if(!s) return null;
+const er=clientRect(e),pr=clientRect(p);
+const clip={left:Math.max(er.left,pr.left),right:Math.min(er.right,pr.right),
+  top:Math.max(er.top,pr.top),bottom:Math.min(er.bottom,pr.bottom)};
+const point={x:(clip.left+clip.right)/2,y:(clip.top+clip.bottom)/2};
+const hit=arguments[1]?document.elementFromPoint(point.x,point.y):null;
+return {editor:er,preview:pr,clip,previewFrom:Number(p.dataset.presentationFrom),
+  previewTo:Number(p.dataset.presentationTo),previewScrollLeft:p.scrollLeft,
+  previewScrollTop:p.scrollTop,svg:s.getBoundingClientRect().toJSON(),scrollTop:e.scrollTop,
+  texts:[...s.querySelectorAll('text')].map(t=>({text:t.textContent,rect:t.getBoundingClientRect().toJSON()})),
+  wheelTarget:arguments[1]?{point,innerWidth,hitTag:hit?.tagName??null,
+    withinPreview:!!hit&&p.contains(hit),withinEditor:!!hit&&e.contains(hit)}:null};`, from, hitTest)
+}
+async function realWheel(direction, sample, text) {
+  const physical = Number(/WIDTH=(\d+)/.exec(x('getwindowgeometry', '--shell', nativeWindow))[1])
+  // Re-read layout and hit-test immediately before XTest; never trust the previous step's rectangle.
+  const geometry = await vectorGeometry(sample, text, true)
+  assert(geometry, 'Target vector still exists before native wheel input')
+  assertPositiveRect(geometry.clip, 'Native wheel target intersects both client viewports')
+  const target = geometry.wheelTarget
+  assert(target.withinPreview && target.withinEditor, 'Native wheel center actually hits this preview inside the editor')
+  assert(Number.isFinite(physical) && physical > 0 && target.innerWidth > 0, 'Native wheel coordinate scale is valid')
+  const point = {x:Math.round(target.point.x * physical / target.innerWidth),
+    y:Math.round(target.point.y * physical / target.innerWidth)}
+  x('mousemove', '--window', nativeWindow, String(point.x), String(point.y), 'click', String(direction))
+  await app.delay(160)
+  return {direction,geometry,nativePoint:point}
+}
+async function revealVectorEdge(sample, text, edge) {
+  const steps = []
+  for (let i = 0; i <= 30; i++) {
+    const g = await vectorGeometry(sample, text)
+    assert(g, 'Previously displayed vector must remain queryable during bounded wheel reveal')
+    assertPositiveRect(g.clip, 'Vector edge has a positive visible client intersection')
+    assertPositiveRect(g.svg, 'Vector has positive geometry')
+    assert(Math.min(g.svg.right,g.clip.right)>Math.max(g.svg.left,g.clip.left), 'Vector edge intersects the client viewport horizontally')
+    steps.push(g)
+    const value = g.svg[edge]
+    if (value >= g.clip.top - 1 && value <= g.clip.bottom + 1) return steps
+    assert(i < 30, 'Vector edge must be reachable with at most 30 real wheel notches')
+    g.wheel = await realWheel(value > g.clip.bottom + 1 ? 5 : 4, sample, text)
+  }
+}
+async function revealLegend(sample, text, label) {
+  const steps=[]
+  for(let i=0;i<=40;i++) {
+    const g=await vectorGeometry(sample,text)
+    assert(g, 'Pie remains available during native legend navigation')
+    const target=g.texts.find(t=>t.text.startsWith(label))
+    assert(target, 'Expected literal pie legend '+label)
+    const r=target.rect,c=g.clip
+    assertPositiveRect(c, 'Pie legend has a positive visible client intersection')
+    assertPositiveRect(r, 'Pie legend text has positive geometry')
+    steps.push({geometry:g,target})
+    if(r.left>=c.left-1 && r.right<=c.right+1 && r.top>=c.top-1 && r.bottom<=c.bottom+1) return steps
+    assert(i<40, 'Pie legend must be fully reachable by bounded real horizontal/vertical wheel input')
+    steps[steps.length-1].wheel = await realWheel(r.right>c.right+1?7:r.left<c.left-1?6:r.bottom>c.bottom+1?5:4,sample,text)
+  }
+}
