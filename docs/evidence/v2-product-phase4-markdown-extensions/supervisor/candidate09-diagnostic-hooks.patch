diff --git a/packages/plugin/src/render-timing-diagnostic.ts b/packages/plugin/src/render-timing-diagnostic.ts
new file mode 100644
index 0000000..c5de917
--- /dev/null
+++ b/packages/plugin/src/render-timing-diagnostic.ts
@@ -0,0 +1,169 @@
+/** DIAGNOSTIC CHECKOUT ONLY. No SDK export and no render authority.
+ * Removing the marked callers plus this file restores the candidate sources.
+ * Debug timestamps never decide completion, cancellation, or timeout.
+ */
+const diagnosticProtocol = 'milkup.diagnostic.render-timing.v1'
+const recordLimit = 1024
+const batchLimit = 16
+const recordByteLimit = 384
+
+type Realm = 'supervisor' | 'child'
+type Stage =
+  | 'supervisor-dispatch'
+  | 'supervisor-result-handler'
+  | 'supervisor-result-late'
+  | 'supervisor-result-accepted'
+  | 'supervisor-expire'
+  | 'child-receive'
+  | 'provider-enter'
+  | 'provider-fulfilled'
+  | 'provider-rejected'
+  | 'output-validation-enter'
+  | 'child-result-post-enter'
+  | 'child-result-post-return'
+
+interface TimingRecord {
+  readonly sequence: number
+  readonly id: string
+  readonly stage: Stage
+  readonly at: number
+  readonly deadline?: number
+}
+
+interface Recorder {
+  mark(stage: Stage, id: string, deadline?: number): void
+  flush(): void
+}
+
+// Module state belongs to one JS realm. WeakMap keys never enter debug frames.
+let realmSequence = 0
+let accepted = 0
+let dropped = 0
+let capReported = false
+const requestIds = new WeakMap<object, { readonly id: string; readonly recorder: Recorder }>()
+const noop: Recorder = Object.freeze({ mark() {}, flush() {} })
+
+function countDrop(): void {
+  dropped = Math.min(Number.MAX_SAFE_INTEGER, dropped + 1)
+}
+
+export function createRenderTimingDiagnostic(
+  realm: Realm,
+  send: (value: unknown) => void,
+): Recorder {
+  try {
+    // This module is also imported by the main RPC client. Its recorder is inert
+    // outside a Worker; it never calls window.postMessage or a global fallback.
+    const workerGlobal = globalThis as unknown as {
+      WorkerGlobalScope?: { prototype?: object }
+    }
+    const workerPrototype = workerGlobal.WorkerGlobalScope?.prototype
+    if (!workerPrototype || !Object.prototype.isPrototypeOf.call(workerPrototype, globalThis))
+      return noop
+    const realmInstance = ++realmSequence
+    const timeOrigin = performance.timeOrigin
+    const now = performance.now.bind(performance)
+    if (!Number.isFinite(timeOrigin)) return noop
+    let disabled = false
+    let sequence = 0
+    let buffer: TimingRecord[] = []
+    const flush = () => {
+      if (disabled) return
+      const capped = accepted >= recordLimit
+      if (!buffer.length && (!capped || capReported)) return
+      const records = buffer
+      buffer = []
+      if (capped) capReported = true
+      try {
+        send({
+          protocol: diagnosticProtocol,
+          type: 'trace',
+          realm,
+          realmInstance,
+          timeOrigin,
+          records,
+          accepted,
+          droppedLowerBound: dropped,
+          capped,
+        })
+      } catch {
+        // No retry, alternate IPC, timer, or error propagation into production.
+        dropped = Math.min(Number.MAX_SAFE_INTEGER, dropped + records.length)
+        disabled = true
+      }
+    }
+    return Object.freeze({
+      mark(stage: Stage, id: string, deadline?: number) {
+        try {
+          if (disabled || accepted >= recordLimit) {
+            countDrop()
+            return
+          }
+          if (!/^[A-Za-z0-9_-]{1,80}$/.test(id)) {
+            countDrop()
+            return
+          }
+          const at = now()
+          if (!Number.isFinite(at) || (deadline !== undefined && !Number.isFinite(deadline))) {
+            countDrop()
+            return
+          }
+          const record: TimingRecord = {
+            sequence: ++sequence,
+            id,
+            stage,
+            at,
+            ...(deadline === undefined ? {} : { deadline }),
+          }
+          // All strings are ASCII enums or validated RPC IDs, so length is bytes.
+          if (JSON.stringify(record).length > recordByteLimit) {
+            countDrop()
+            return
+          }
+          accepted++
+          buffer.push(record)
+          if (buffer.length >= batchLimit) flush()
+        } catch {
+          countDrop()
+        }
+      },
+      flush,
+    })
+  } catch {
+    return noop
+  }
+}
+
+export function bindRenderTimingRequest(request: object, id: string, recorder: Recorder): void {
+  try {
+    requestIds.set(request, { id, recorder })
+  } catch {
+    countDrop()
+  }
+}
+
+export function traceRenderTimingRequest(request: object, stage: Stage, flush = false): void {
+  try {
+    const binding = requestIds.get(request)
+    if (!binding) return
+    binding.recorder.mark(stage, binding.id)
+    if (flush) binding.recorder.flush()
+  } catch {
+    countDrop()
+  }
+}
+
+/** Observation filter only. Never used by the authority or settlement grammar. */
+export function diagnosticResultMatches(value: unknown, id: string): boolean {
+  try {
+    if (!value || typeof value !== 'object' || Array.isArray(value)) return false
+    const message = value as Record<string, unknown>
+    return (
+      message.protocol === 'milkup.plugin.document-render.v1' &&
+      message.type === 'result' &&
+      message.id === id
+    )
+  } catch {
+    return false
+  }
+}
