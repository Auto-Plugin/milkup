  },
  {
    "directory": "plugins/updates",
    "permissions": ["app:updates"]
  },
  {
    "directory": "plugins/workspace",
    "permissions": ["workspace:read"]
  },
  {
    "directory": "plugins/preferences",
    "permissions": ["settings:write"]
  },
  {
