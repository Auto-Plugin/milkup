{
  "id": "milkup.outline",
  "name": "Milkup Outline",
  "version": "1.3.4",
  "description": "Show a read-only document outline.",
  "host": "worker",
  "main": "./dist/plugin.js",
  "engines": {
    "milkup": "^2.0.0-0",
    "pluginSdk": ">=0.2.0 <0.4.0"
  },
  "permissions": ["document:read"],
  "contributes": {
    "commands": [
      {
        "id": "outline.gotoHeading",
        "title": "Go to heading",
        "action": "outline.gotoHeading",
        "category": "navigation",
        "inputSchema": {
          "type": "object",
          "properties": {
            "line": {
              "type": "number",
              "required": true,
              "description": "Heading line number"
            },
            "documentId": {
              "type": "string",
              "required": true
            },
            "version": {
              "type": "number",
              "required": true
            },
            "generation": {
              "type": "number",
              "required": true
            },
            "ordinal": {
              "type": "number",
              "required": true
            },
            "id": {
              "type": "string",
              "required": true
            }
          }
        }
      },
      {
        "id": "outline.toggleHeading",
        "title": "Collapse or expand heading",
        "action": "outline.toggleHeading",
        "category": "navigation",
        "inputSchema": {
          "type": "object",
          "properties": {
            "line": {
              "type": "number",
              "required": true,
              "description": "Positive integer heading line number"
            },
            "documentId": {
              "type": "string",
              "required": true
            },
            "version": {
              "type": "number",
              "required": true
            },
            "generation": {
              "type": "number",
              "required": true
            },
            "ordinal": {
              "type": "number",
              "required": true
            },
            "id": {
              "type": "string",
              "required": true
            }
          }
        }
      },
      {
        "id": "outline.collapseAll",
        "title": "Collapse all headings",
        "action": "outline.collapseAll",
        "category": "navigation"
      },
      {
        "id": "outline.expandAll",
        "title": "Expand all headings",
        "action": "outline.expandAll",
        "category": "navigation"
      },
      {
        "id": "outline.cancel",
        "title": "Cancel outline indexing",
        "action": "outline.cancel",
        "category": "navigation"
      },
      {
        "id": "outline.retry",
        "title": "Retry outline indexing",
        "action": "outline.retry",
        "category": "navigation"
      }
    ],
    "ui": [
      {
        "id": "outline-panel",
        "slot": "sidebar-panel",
        "title": "大纲",
        "scope": "document",
        "viewportUpdates": true
      }
    ]
  }
}
