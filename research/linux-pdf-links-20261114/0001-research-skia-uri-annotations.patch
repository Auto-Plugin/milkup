+
+void GraphicsContextSkia::setURLForRect(const URL& url, const FloatRect& rect)
+{
+    if (paintingDisabled() || !url.isValid() || rect.isEmpty())
+        return;
+
+    auto data = SkData::MakeWithCString(url.string().utf8().data());
+    SkAnnotateRectWithURL(&m_canvas, rect, data.get());
 }
 
