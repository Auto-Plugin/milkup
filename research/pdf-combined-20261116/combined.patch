+// RESEARCH ONLY: same-process page boundaries for all controlled fixture kinds.
+static void milkupCombinedPage(Document& document, int page, const char* phase, bool ready)
+{
+    if (!std::getenv("MILKUP_COMBINED_PROBE"))
+        return;
