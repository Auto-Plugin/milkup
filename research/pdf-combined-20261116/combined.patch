+// Research-only source metadata bridge; not an installed WebKit patch.
+// Copyright (C) 2026 LarryZhu-dev. SPDX-License-Identifier: BSD-2-Clause
+#pragma once
+#include <cstdint>
+#include <limits>
+#include <optional>
+#include <span>
+#include <string>
+#include <string_view>
