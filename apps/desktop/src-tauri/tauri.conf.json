  },
  "app": {
    "windows": [
      {
        "title": "milkup",
        "width": 1100,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520
      }
    ]
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
