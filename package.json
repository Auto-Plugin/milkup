{
  "name": "milkup2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "pnpm --filter @milkup/playground dev",
    "build": "pnpm -r build",
    "bench:large-file": "node scripts/large-file-benchmark.mjs",
    "bench:native:large-file": "node tests/native/tauri-large-file-benchmark.mjs",
    "manual:apply": "node scripts/apply-manual-verification-report.mjs",
    "manual:cross-platform": "node scripts/open-manual-verification-cross-platform.mjs",
    "manual:validate": "node scripts/validate-manual-verification-report.mjs",
    "manual:windows": "cmd /c scripts\\open-manual-verification-windows.cmd",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "test:native:desktop": "node tests/native/tauri-webdriver-smoke.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.0.10",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
