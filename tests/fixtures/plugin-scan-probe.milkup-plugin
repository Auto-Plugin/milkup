{"format": "milkup-plugin", "version": 1, "manifest": {"id": "example.scan-probe", "name": "Full document scan measurement", "version": "1.0.0", "host": "worker", "main": "./dist/probe.js", "engines": {"milkup": "^0.1.0", "pluginSdk": "^0.1.0"}, "permissions": ["document:read"], "contributes": {"commands": [{"id": "measure.run", "title": "Run full scan", "action": "measure.run", "category": "navigation"}], "ui": [{"id": "probe", "title": "Scan measurement", "slot": "sidebar-panel", "scope": "document", "viewportUpdates": false}]}}, "files": [{"path": "dist/probe.js", "encoding": "utf8", "content": "let host, scanner, generation=0, current='',version, run=0, report={status:'idle'};\nasync function scan(id,v){const g=++generation;const old=scanner;scanner=undefined;await old?.cancel();if(g!==generation)return;const start=performance.now();report={status:'running',run:++run,events:0,batches:0,items:0,firstResultMs:null};void host.ui.requestUpdate('probe');try{scanner=host.document.scan({query:{kind:'markdownHeadings'},fromLine:1,toLine:40001,windowSizeLines:4096,batchSize:128,maxResults:50000});for await(const e of scanner){if(g!==generation)return;report.events++;if(e.type==='batch'){report.batches++;report.items+=e.items.length;if(report.firstResultMs===null)report.firstResultMs=performance.now()-start;}if(e.type==='done'){report={...report,status:e.reason,elapsedMs:performance.now()-start,scannedLines:e.scannedLineCount,totalLines:e.totalLineCount};await host.ui.requestUpdate('probe');return;}}}catch(e){report={...report,status:'failed',error:String(e)};await host.ui.requestUpdate('probe');}}\nexport default {commands:{'measure.run':()=>{void scan(current,version)}},activate(c){host=c.host;return{dispose(){generation++;return scanner?.cancel();}}},renderers:{probe(c){if(c.node?.phase==='dispose'){generation++;void scanner?.cancel();return '';}if(c.node?.documentId!==current||c.node?.documentVersion!==version){current=c.node?.documentId;version=c.node?.documentVersion;void scan(current,version);}return {type:'element',tag:'span',children:[{type:'element',tag:'button',text:'Run scan',action:{command:'measure.run'}},{type:'element',tag:'span',attributes:{class:'plugin-list-summary'},text:JSON.stringify(report)}]};}}};"}]}